{
  "manifest_version": 2,
  "name": "ura",
  "version": "0.4.0",
  "description": "Send the current tab URL through your local ura node.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "http://127.0.0.1/*"
  ],
  "browser_action": {
    "default_title": "Send to ura"
  },
  "background": {
    "scripts": [
      "lib.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  }
}
